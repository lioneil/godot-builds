+void DisplayServerX11::_sync_answer(WindowData &wd) {
+	XSyncValue value;
+	value.hi = (int)(wd.sync_serial >> 32);
+	value.lo = (unsigned int)(wd.sync_serial & 0xFFFFFFFF);
+	XSyncSetCounter(x11_display, wd.sync_counter, value);
+	XFlush(x11_display);
+	wd.sync_pending = false;
+	wd.sync_resized = false;
+	sync_pending_count.decrement();
+}
+
+void DisplayServerX11::_sync_destroy_counter(WindowData &wd) {
+	if (wd.sync_size_undrawn) {
+		wd.sync_size_undrawn = false;
+		sync_undrawn_count.decrement();
+	}
+	if (wd.sync_pending) {
+		wd.sync_pending = false;
+		wd.sync_resized = false;
+		sync_pending_count.decrement();
+	}
+	if (wd.sync_counter != None) {
+		XSyncDestroyCounter(x11_display, wd.sync_counter);
+		wd.sync_counter = None;
+	}
+}
